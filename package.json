{
  "name": "image-prompt-book",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm content:check && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "content:check": "tsx scripts/check-content.ts",
    "content:import": "tsx scripts/import-appendix.ts",
    "links:check": "tsx scripts/check-links.ts",
    "test": "vitest run -c tests/vitest.config.mts",
    "test:e2e": "playwright test -c tests/playwright.config.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "vitals": "tsx scripts/measure-vitals.ts"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "^0.3.2",
    "lucide-react": "1.47.0",
    "next": "16.3.6",
    "next-intl": "4.14.6",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "image-size": "2.0.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
